# SPDX-License-Identifier: Apache-2.0
#
# Everything here runs in a container, because .SRCINFO has to be generated by
# the same `makepkg` the AUR validates against and this is not an Arch machine.
#
# Two images, picked by host arch. `archlinux:base-devel` is the official one
# and x86_64-only, which is enough to read a PKGBUILD and not enough to compile
# one: emulated on Apple silicon, the Zig compiler takes a SEGV of its own. So
# an arm64 host gets a community-built Arch instead, pinned by digest - that
# image's manifest mislabels its arm64 entry as amd64, so `--platform
# linux/arm64` cannot resolve the tag at all and only the digest works. It
# rolls, and the `pacman -Syu` in each target is what keeps it current, so a
# stale digest costs one download and nothing else.
ARM64_IMAGE := lopsided/archlinux@sha256:63c8d3c53f643ff81241058f30f26b1fc5debea807c1b326e3f85814eac87d37

ifeq ($(shell uname -m),arm64)
  IMAGE    := $(ARM64_IMAGE)
  PLATFORM :=
else
  IMAGE    := archlinux:base-devel
  PLATFORM := --platform linux/amd64
endif

# `--disable-sandbox` below: pacman's own sandbox needs seccomp permissions
# Docker's default profile denies, and without it every database sync fails.
DOCKER := docker run --rm $(PLATFORM) --security-opt seccomp=unconfined

.PHONY: help srcinfo lint build

help:
	@printf "Targets:\n"
	@printf "  make srcinfo   regenerate .SRCINFO for both packages\n"
	@printf "  make lint      namcap both PKGBUILDs\n"
	@printf "  make build     run lgtm-git's build() and check() for real\n"

srcinfo:
	$(DOCKER) -v "$(CURDIR):/pkg" $(IMAGE) bash -lc '\
	  set -eu; \
	  pacman -Sy --noconfirm --disable-sandbox >/dev/null 2>&1; \
	  useradd -m build; chown -R build /pkg; \
	  for p in lgtm-bin lgtm-git; do \
	    su build -c "cd /pkg/$$p && makepkg --printsrcinfo > .SRCINFO"; \
	    echo "wrote $$p/.SRCINFO"; \
	  done'

lint:
	$(DOCKER) -v "$(CURDIR):/pkg" $(IMAGE) bash -lc '\
	  set -eu; \
	  pacman -Syu --noconfirm --disable-sandbox --needed namcap >/dev/null 2>&1; \
	  for p in lgtm-bin lgtm-git; do echo "== $$p"; namcap /pkg/$$p/PKGBUILD || true; done'

# Clones main and compiles it, which is the one thing --printsrcinfo and namcap
# cannot tell you. Three things the recipe is shaped by: dependencies go in as
# root first because `makepkg -s` shells out to sudo and there is no password
# here; the mount is read-only so a build cannot touch the working tree; and
# the PKGBUILD is copied out of it because makepkg *writes* the computed
# pkgver back into the file, and skips pkgver() entirely - with a warning
# rather than an error - when it cannot. On a read-only mount the run is green
# and the version is still the placeholder, which is the failure this whole
# target exists to catch.
build:
	$(DOCKER) -v "$(CURDIR):/pkg:ro" $(IMAGE) bash -lc '\
	  set -eu; \
	  pacman -Syu --noconfirm --disable-sandbox --needed git zig >/dev/null 2>&1; \
	  zig version; \
	  useradd -m build; install -d -o build /work; \
	  cp -r /pkg/lgtm-git /work/lgtm-git; chown -R build /work/lgtm-git; \
	  su build -c "cd /work/lgtm-git && BUILDDIR=/work/b PKGDEST=/work/p SRCDEST=/work/s makepkg --noconfirm"; \
	  echo "== package contents =="; \
	  bsdtar -tf /work/p/*.pkg.tar.* | grep -v "^\."'
